    {
      "id": "UiHNOMKJrrtzDHGsCb8yF",
      "type": "text",
      "x": 0,
      "y": 940,
      "width": 1176.8792724609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 1084838164,
      "version": 2,
      "versionNonce": 1057286572,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100082162,
      "link": null,
      "locked": false,
      "text": "4 scans instead of 16, and no empty CTA waits for a slot. At b = 64 per GPU, the 384 rows are fewer than the\n1,184 CTAs, so each CTA takes at most one row and the loop runs at most once. The gain is the 23,392 CTAs not launched.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 scans instead of 16, and no empty CTA waits for a slot. At b = 64 per GPU, the 384 rows are fewer than the\n1,184 CTAs, so each CTA takes at most one row and the loop runs at most once. The gain is the 23,392 CTAs not launched.",
      "autoResize": true,
      "lineHeight": 1.25
    },
