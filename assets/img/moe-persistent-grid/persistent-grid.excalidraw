      "text": "num_rows = min(scan(masked_m -> s_row_end), T x topk)\nif (blockIdx.x >= num_rows) return\nfor (r = blockIdx.x; r < num_rows; r += gridDim.x) {\n  e = find_expert(s_row_end, r)        // binary search\n  j = r - (e == 0 ? 0 : s_row_end[e - 1])\n  silu_mul_quant_row(e, j)             // same math in both grids\n}",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "A8pL5otdeWNsLF6SJM5lt",
      "originalText": "num_rows = min(scan(masked_m -> s_row_end), T x topk)\nif (blockIdx.x >= num_rows) return\nfor (r = blockIdx.x; r < num_rows; r += gridDim.x) {\n  e = find_expert(s_row_end, r)        // binary search\n  j = r - (e == 0 ? 0 : s_row_end[e - 1])\n  silu_mul_quant_row(e, j)             // same math in both grids\n}",
      "autoResize": true,
      "lineHeight": 1.2
    },
