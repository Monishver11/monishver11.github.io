      "updated": 1792100082164,
      "link": null,
      "locked": false,
      "text": "lo = 0, hi = 3\nmid = 1: s_row_end[1] = 3 > 3? no  -> lo = 2\nmid = 2: s_row_end[2] = 5 > 3? yes -> hi = 2\nlo = hi = 2  -> expert e2, row 3 - 3 = 0",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "HqPYkNzBF2JhVmnq87IiL",
      "originalText": "lo = 0, hi = 3\nmid = 1: s_row_end[1] = 3 > 3? no  -> lo = 2\nmid = 2: s_row_end[2] = 5 > 3? yes -> hi = 2\nlo = hi = 2  -> expert e2, row 3 - 3 = 0",
      "autoResize": true,
      "lineHeight": 1.2
    },
