      "locked": false,
      "text": "grid = min(SMs x CTAs per SM, T x topk)\n      = min(4, 16) = 4 in the toy\n\ns_row_end lives in shared memory,\none copy per CTA, from that CTA's scan.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "grid = min(SMs x CTAs per SM, T x topk)\n      = min(4, 16) = 4 in the toy\n\ns_row_end lives in shared memory,\none copy per CTA, from that CTA's scan.",
      "autoResize": true,
      "lineHeight": 1.25
    },
