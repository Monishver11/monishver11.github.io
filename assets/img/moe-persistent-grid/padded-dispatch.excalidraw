    {
      "id": "ZbVipSbw9RMDI3UwtdhRa",
      "type": "text",
      "x": 750,
      "y": 454,
      "width": 259.77587890625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1765159212,
      "version": 2,
      "versionNonce": 389712684,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100080026,
      "link": null,
      "locked": false,
      "text": "[E_local] int32, on the GPU",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[E_local] int32, on the GPU",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VM4Ew3bzWU7w7mX3xuY5u",
      "type": "text",
      "x": 620,
      "y": 497,
      "width": 525.5817260742188,
      "height": 90,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 291620756,
      "version": 2,
      "versionNonce": 2011696532,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100080026,
      "link": null,
      "locked": false,
      "text": "T = 8 is the worst case for one expert: all 4 + 4 tokens\nthat the 2 GPUs may send pick the same expert.\nRow order inside an expert is DeepEP's choice;\nthe kernels only use the count.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T = 8 is the worst case for one expert: all 4 + 4 tokens\nthat the 2 GPUs may send pick the same expert.\nRow order inside an expert is DeepEP's choice;\nthe kernels only use the count.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "35jLkHxbthLaG8WQHR6uP",
      "type": "text",
      "x": 0,
      "y": 622,
      "width": 1002.879150390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 70200236,
      "version": 2,
      "versionNonce": 1687700908,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100080026,
      "link": null,
      "locked": false,
      "text": "Expert e owns rows [0, masked_m[e]) of its T rows. The other rows are not written by dispatch,\nand every later buffer (gateup, q, down) keeps the same rows. GPU 1 receives e2, e3 the same way.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expert e owns rows [0, masked_m[e]) of its T rows. The other rows are not written by dispatch,\nand every later buffer (gateup, q, down) keeps the same rows. GPU 1 receives e2, e3 the same way.",
      "autoResize": true,
      "lineHeight": 1.25
    },
