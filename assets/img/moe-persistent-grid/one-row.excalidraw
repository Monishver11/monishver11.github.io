    },
    {
      "id": "GobFnOdbLllTCtsKWNapy",
      "type": "text",
      "x": 720,
      "y": 190,
      "width": 309.49078369140625,
      "height": 142.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 2125674156,
      "version": 2,
      "versionNonce": 1142028948,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100083203,
      "link": null,
      "locked": false,
      "text": "256 threads = 8 warps\n= 16 groups of 16 threads\n= 16 scales per row\n\nthreads per CTA = D / 8\n(so 256 for Flash, 384 for Pro)",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "256 threads = 8 warps\n= 16 groups of 16 threads\n= 16 scales per row\n\nthreads per CTA = D / 8\n(so 256 for Flash, 384 for Pro)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e4npHC9vGvIicsGjQ88_u",
      "type": "text",
      "x": 0,
      "y": 700,
      "width": 886.79931640625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1648482836,
      "version": 2,
      "versionNonce": 974104748,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100083203,
      "link": null,
      "locked": false,
      "text": "Both grids run this same math on each row. They differ only in which CTA runs which row.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both grids run this same math on each row. They differ only in which CTA runs which row.",
      "autoResize": true,
      "lineHeight": 1.25
    },
