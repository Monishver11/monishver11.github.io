      "updated": 1792100083203,
      "link": null,
      "locked": false,
      "text": "group of 128 outputs = 16 threads (half a warp):\nabsmax = shuffle-max of m over the 16 lanes",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "jklekwerNkbFHcFkkNugy",
      "originalText": "group of 128 outputs = 16 threads (half a warp):\nabsmax = shuffle-max of m over the 16 lanes",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "9rsQfnQ42I37_GahChbx2",
      "type": "text",
      "x": 5,
      "y": 454.2,
      "width": 527.9296875,
      "height": 81.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 949485612,
      "version": 3,
      "versionNonce": 1691781036,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100083203,
      "link": null,
      "locked": false,
      "text": "Blackwell (UE8M0): scale = 2^ceil(log2(absmax / 448))\nHopper (fp32):     scale = absmax / 448\nq = fp8_e4m3(clip(v / scale, -448, 448))\neach thread writes 8 fp8 = 8 B",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "fS_wiG6Q2OtyfMNGYQ1F2",
      "originalText": "Blackwell (UE8M0): scale = 2^ceil(log2(absmax / 448))\nHopper (fp32):     scale = absmax / 448\nq = fp8_e4m3(clip(v / scale, -448, 448))\neach thread writes 8 fp8 = 8 B",
      "autoResize": true,
      "lineHeight": 1.2
    },
