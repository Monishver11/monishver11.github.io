      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100083203,
      "link": null,
      "locked": false,
      "text": "per thread, 8 values:\ng = min(gate, 10),  u = clamp(up, -10, 10)    in bf16\nv = g / (1 + exp(-g)) * u                     in fp32\nm = max |v| over its 8 values",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Lthi5zfP0KFcVH3pm_oMs",
      "originalText": "per thread, 8 values:\ng = min(gate, 10),  u = clamp(up, -10, 10)    in bf16\nv = g / (1 + exp(-g)) * u                     in fp32\nm = max |v| over its 8 values",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "YOp7fAovQoy849bhXCwgd",
      "type": "text",
      "x": 5,
      "y": 334.6,
      "width": 478.125,
      "height": 40.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
