    {
      "id": "cwe3e_i7lNoYsPHL2yPG-",
      "type": "text",
      "x": 820,
      "y": 556,
      "width": 391.0137023925781,
      "height": 45,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 320830252,
      "version": 2,
      "versionNonce": 2080851476,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100081052,
      "link": null,
      "locked": false,
      "text": "r = 3:  s_row_end[1] = 3 is not > 3,\nso e1 (empty) is skipped. e2, row 3 - 3 = 0.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "r = 3:  s_row_end[1] = 3 is not > 3,\nso e1 (empty) is skipped. e2, row 3 - 3 = 0.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2NObvvJBMB9ODEZ0ovR2T",
      "type": "text",
      "x": 0,
      "y": 730,
      "width": 1148.3790283203125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1292508564,
      "version": 2,
      "versionNonce": 528930092,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100081052,
      "link": null,
      "locked": false,
      "text": "Both grids in this post use the same numbering. The total s_row_end[E_local - 1] = 6 is the number of real rows.\nThe grids differ in how many CTAs compute the prefix sum, and which flat rows each CTA takes (figures 4 and 5).",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both grids in this post use the same numbering. The total s_row_end[E_local - 1] = 6 is the number of real rows.\nThe grids differ in how many CTAs compute the prefix sum, and which flat rows each CTA takes (figures 4 and 5).",
      "autoResize": true,
      "lineHeight": 1.25
    },
