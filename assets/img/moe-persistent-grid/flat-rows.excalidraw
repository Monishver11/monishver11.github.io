    {
      "id": "2tDMrhrk8a65GbeXda-wZ",
      "type": "text",
      "x": 5,
      "y": 582.5,
      "width": 630.3056640625,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 145072044,
      "version": 3,
      "versionNonce": 1715930668,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100081053,
      "link": null,
      "locked": false,
      "text": "Flat row r belongs to the first expert e with s_row_end[e] > r.\nIts row inside e is r - s_row_end[e - 1]  (0 when e = 0).\nExample: r = 5.  s_row_end[0] = 4 <= 5,  s_row_end[1] = 6 > 5,\nso e1, row 5 - 4 = 1, which is t4.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "_C7IiWPrB_mgBn3hGDtqB",
      "originalText": "Flat row r belongs to the first expert e with s_row_end[e] > r.\nIts row inside e is r - s_row_end[e - 1]  (0 when e = 0).\nExample: r = 5.  s_row_end[0] = 4 <= 5,  s_row_end[1] = 6 > 5,\nso e1, row 5 - 4 = 1, which is t4.",
      "autoResize": true,
      "lineHeight": 1.25
    },
