      "text": "padded layout:\nT rows reserved\nper local expert.\nOnly masked_m[e]\nrows are real.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "padded layout:\nT rows reserved\nper local expert.\nOnly masked_m[e]\nrows are real.",
