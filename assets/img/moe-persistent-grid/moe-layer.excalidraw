    {
      "id": "3ffFm78H9hwX-RdMAzLC0",
      "type": "text",
      "x": 0,
      "y": 1012,
      "width": 682.65625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 722245780,
      "version": 2,
      "versionNonce": 1955541908,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100078902,
      "link": null,
      "locked": false,
      "text": "masked_m is written on the GPU by dispatch. The host cannot read it without a sync,\nand a sync breaks the CUDA graph, so every launch is sized for T rows per expert.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "masked_m is written on the GPU by dispatch. The host cannot read it without a sync,\nand a sync breaks the CUDA graph, so every launch is sized for T rows per expert.",
      "autoResize": true,
      "lineHeight": 1.25
    },
