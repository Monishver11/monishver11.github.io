    {
      "id": "rUQmdo0RUWxaVmiHGw6gD",
      "type": "text",
      "x": 150,
      "y": 556,
      "width": 891.7014770507812,
      "height": 45,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 269278612,
      "version": 2,
      "versionNonce": 1535728044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100081116,
      "link": null,
      "locked": false,
      "text": "gray = scan only (1 unit), color = scan + one row (1 + 3 units). The scheduler starts the next CTA\nin a slot as soon as the slot is free. Empty CTAs still take a slot, a launch and a scan.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "gray = scan only (1 unit), color = scan + one row (1 + 3 units). The scheduler starts the next CTA\nin a slot as soon as the slot is free. Empty CTAs still take a slot, a launch and a scan.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uid_rNgU89Oos0OJiKvWK",
      "type": "text",
      "x": 0,
      "y": 640,
      "width": 921.519287109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 1776842156,
      "version": 2,
      "versionNonce": 2140366612,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792100081116,
      "link": null,
      "locked": false,
      "text": "In the toy, 10 empty CTAs hide behind 6 real ones. In the real case, empty CTAs outnumber\nthe slots about 20 to 1, so every slot runs about 20 empty CTAs back to back.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the toy, 10 empty CTAs hide behind 6 real ones. In the real case, empty CTAs outnumber\nthe slots about 20 to 1, so every slot runs about 20 empty CTAs back to back.",
      "autoResize": true,
      "lineHeight": 1.25
    },
