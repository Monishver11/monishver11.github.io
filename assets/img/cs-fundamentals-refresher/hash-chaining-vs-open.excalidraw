   "locked": false,
   "text": "lookup 'emu': hash -> bucket 2, then follow\npointers comparing keys: 1 + alpha expected.\nEvery hop is a pointer chase into a separate\nheap allocation, so each hop can miss cache.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "lookup 'emu': hash -> bucket 2, then follow\npointers comparing keys: 1 + alpha expected.\nEvery hop is a pointer chase into a separate\nheap allocation, so each hop can miss cache.",
   "autoResize": true,
   "lineHeight": 1.25
  },
