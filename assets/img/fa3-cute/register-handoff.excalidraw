   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "thread t: r = floor((t mod 32)/4) + 16w, c = t mod 4; C value (v0, v1, v2) is at row r + 8 v1, column 8 v2 + 2c + v0",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "thread t: r = floor((t mod 32)/4) + 16w, c = t mod 4; C value (v0, v1, v2) is at row r + 8 v1, column 8 v2 + 2c + v0",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
  },
  {
   "id": "e0003",
   "type": "text",
   "x": 20,
   "y": 62,
   "width": 707.85,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
