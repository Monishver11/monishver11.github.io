  {
   "id": "e0103",
   "type": "text",
   "x": 20,
   "y": 386,
   "width": 779.35,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1.5,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 815657,
   "version": 1,
   "versionNonce": 10787087,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "convert_c_layout_to_a_layout(c, a) builds the layout (a, c.shape[1], (c.shape[2], size(c, mode 0) / size(a)))\nwith the K-block stride equal to size(a, mode 2) times c's v2 stride, so K block kb takes the C groups\nv2 = 2kb and 2kb + 1 in register order. make_acc_into_op allocates the 8 x 1 x 4 tensor, aliases it under\nthe C layout, and does one load, one cast to BF16, one store. No lane exchanges data in the BF16 case.\nEight values per K block matches the PTX A fragment for m64nNk16: four .f16x2 registers per thread.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "convert_c_layout_to_a_layout(c, a) builds the layout (a, c.shape[1], (c.shape[2], size(c, mode 0) / size(a)))\nwith the K-block stride equal to size(a, mode 2) times c's v2 stride, so K block kb takes the C groups\nv2 = 2kb and 2kb + 1 in register order. make_acc_into_op allocates the 8 x 1 x 4 tensor, aliases it under\nthe C layout, and does one load, one cast to BF16, one store. No lane exchanges data in the BF16 case.\nEight values per K block matches the PTX A fragment for m64nNk16: four .f16x2 registers per thread.",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
  }
 ],
