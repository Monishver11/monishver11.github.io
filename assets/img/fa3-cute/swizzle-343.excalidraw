  {
   "id": "e0198",
   "type": "text",
   "x": 474,
   "y": 284,
   "width": 300.3,
   "height": 227.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1.5,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1567962,
   "version": 1,
   "versionNonce": 20736342,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Reading logical chunk 0 of all eight rows\n(highlighted) touches physical chunks\n0, 1, 2, ..., 7: eight different 16-byte\npositions in their 128-byte rows, so eight\ndifferent bank groups and no conflict.\n\nWithout the swizzle the same read hits\nphysical chunk 0 in every row: the same\n4 banks eight times, serialized.\n\nRow 0 is never permuted (r = 0), and\nthe pattern repeats every 1024 bytes,\nwhich is why operand buffers are\n1024-byte aligned.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Reading logical chunk 0 of all eight rows\n(highlighted) touches physical chunks\n0, 1, 2, ..., 7: eight different 16-byte\npositions in their 128-byte rows, so eight\ndifferent bank groups and no conflict.\n\nWithout the swizzle the same read hits\nphysical chunk 0 in every row: the same\n4 banks eight times, serialized.\n\nRow 0 is never permuted (r = 0), and\nthe pattern repeats every 1024 bytes,\nwhich is why operand buffers are\n1024-byte aligned.",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
  }
 ],
