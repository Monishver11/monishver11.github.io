   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "each row is 128 bytes = eight 16-byte chunks = one pass over the 32 banks",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "each row is 128 bytes = eight 16-byte chunks = one pass over the 32 banks",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 12
  },
