   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where logical chunk c of row r is stored: physical chunk c XOR r",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Where logical chunk c of row r is stored: physical chunk c XOR r",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 16
  },
