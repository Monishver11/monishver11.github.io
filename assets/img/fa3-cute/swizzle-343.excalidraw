   "versionNonce": 4189160,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MBase = 4: the low 4 bits never change,\nso a 16-byte chunk stays intact.\nBBits = 3: three bits move.\nSShift = 3: the source bits sit three\nabove the target bits.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "MBase = 4: the low 4 bits never change,\nso a 16-byte chunk stays intact.\nBBits = 3: three bits move.\nSShift = 3: the source bits sit three\nabove the target bits.",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
  },
