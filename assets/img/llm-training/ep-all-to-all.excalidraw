   "text": "every rank sends to every rank: one all-to-all carrying k x h values per token",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "every rank sends to every rank: one all-to-all carrying k x h values per token",
