  {
   "id": "el0116",
   "type": "text",
   "x": 20,
   "y": 545,
   "width": 1194.0500000000002,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
