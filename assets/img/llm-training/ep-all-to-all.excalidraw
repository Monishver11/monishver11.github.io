   "seed": 418802349,
   "version": 1,
   "versionNonce": 1543475404,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "per MoE layer per token, DeepSeek-V3 (h = 7168, k = 8, bf16): 8 x 7168 x 2 = 115 KB out and 115 KB back; the 64-way EP group spans 8 nodes, so this crosses InfiniBand.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "per MoE layer per token, DeepSeek-V3 (h = 7168, k = 8, bf16): 8 x 7168 x 2 = 115 KB out and 115 KB back; the 64-way EP group spans 8 nodes, so this crosses InfiniBand.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0117",
   "type": "text",
   "x": 20,
   "y": 570,
   "width": 922.35,
   "height": 16.25,
