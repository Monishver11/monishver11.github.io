   "locked": false,
   "text": "Pipeline schedules: GPipe versus 1F1B   (p = 4 stages, m = 8 microbatches, forward and backward drawn the same width)",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Pipeline schedules: GPipe versus 1F1B   (p = 4 stages, m = 8 microbatches, forward and backward drawn the same width)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0250",
   "type": "text",
   "x": 20,
   "y": 44,
   "width": 1185.8000000000002,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1905969461,
   "version": 1,
   "versionNonce": 598583810,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "F = forward of a microbatch, B = its backward, gray = bubble (stage idle). Both schedules idle each stage for 2(p-1) = 6 slots out of 22: the same bubble.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "F = forward of a microbatch, B = its backward, gray = bubble (stage idle). Both schedules idle each stage for 2(p-1) = 6 slots out of 22: the same bubble.",
   "autoResize": true,
   "lineHeight": 1.25
  },
