artBinding": null, "endBinding": null, "lastCommittedPoint": null, "elbowed": false}, {"type": "text", "x": 726, "y": 410, "width": 400, "height": 18, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0094", "roundness": null, "seed": 2049725601, "version": 1, "versionNonce": 1214866703, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0094", "text": "budget B = 4 bonus + 11 draft = 15 tokens this step", "originalText": "budget B = 4 bonus + 11 draft = 15 tokens this step", "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "middle", "lineHeight": 1.25, "autoResize": false, "containerId": null}, {"type": "text", "x": 40, "y": 440, "width": 1200, "height": 52.800000000000004, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0095", "roundness": null, "seed": 338601166, "version": 1, "versionNonce": 1789426698, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0095", "text": "tau = expected accepted tokens = sum of admitted survivals + one bonus per request; SPS(B) = profiled steps per second at B tokens.\nAdding a slot raises tau and lowers SPS(B); the walk stops at the first step where the product falls. At high load SPS drops faster, so fewer slots are admitted.\nGreen slots always form a contiguous prefix per request because survival is non-increasing along a draft.", "originalText": "tau = expected accepted tokens = sum of admitted survivals + one bonus per request; SPS(B) = profiled steps per second at B tokens.\nAdding a slot raises tau and lowers SPS(B); the walk stops at the first step where the product falls. At high load SPS drops faster, so fewer slots are admitted.\nGreen slots always form a contiguous prefix per request because survival is non-increasing along a draft.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "middle", "lineHeight": 1.25, "autoResize": false, "containerId": null}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#fdf8f6", "lockedMultiSelections": {}}, "files": {}}