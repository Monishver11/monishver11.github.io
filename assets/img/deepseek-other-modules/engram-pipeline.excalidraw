d": 1789071763372, "link": null, "locked": false, "id": "el0097"}, {"type": "text", "x": 500, "y": 428, "width": 300, "height": 46, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0098", "roundness": null, "seed": 1964196104, "version": 1, "versionNonce": 365086747, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0098", "text": "stream_m += alpha_m * value", "originalText": "stream_m += alpha_m * value", "fontSize": 12, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "lineHeight": 1.25, "autoResize": false, "containerId": null}, {"type": "arrow", "x": 460, "y": 451, "width": 40, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0099", "roundness": null, "seed": 169849916, "version": 1, "versionNonce": 5867099, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0099", "points": [[0, 0], [40, 0]], "startArrowhead": null, "endArrowhead": "arrow", "startBinding": null, "endBinding": null, "lastCommittedPoint": null, "elbowed": false}, {"type": "arrow", "x": 1090, "y": 360, "width": 290, "height": 91, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0100", "roundness": null, "seed": 539670267, "version": 1, "versionNonce": 998909883, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0100", "points": [[0, 0], [0, 91], [-290, 91]], "startArrowhead": null, "endArrowhead": "arrow", "startBinding": null, "endBinding": null, "lastCommittedPoint": null, "elbowed": false}, {"type": "text", "x": 40, "y": 490, "width": 1200, "height": 37.2, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0101", "roundness": null, "seed": 161455264, "version": 1, "versionNonce": 1304734861, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0101", "text": "Every index depends only on token ids, so the 24 gathers per module are issued before the forward pass; DeepSeek prefetches them from host memory over RDMA\nwhile block 0 computes. Both modules: 48 rows, 12 KiB per token; the projection is ~0.6 GFLOP per token against ~32 GFLOP for the 16B activated backbone.", "originalText": "Every index depends only on token ids, so the 24 gathers per module are issued before the forward pass; DeepSeek prefetches them from host memory over RDMA\nwhile block 0 computes. Both modules: 48 rows, 12 KiB per token; the projection is ~0.6 GFLOP per token against ~32 GFLOP for the 16B activated backbone.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "middle", "lineHeight": 1.25, "autoResize": false, "containerId": null}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#fdf8f6", "lockedMultiSelections": {}}, "files": {}}