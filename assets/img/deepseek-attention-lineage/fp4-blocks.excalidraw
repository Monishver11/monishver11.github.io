 "y": 470, "width": 1200, "height": 40, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0109", "roundness": null, "seed": 2128996440, "version": 1, "versionNonce": 860770736, "isDeleted": false, "boundElements": null, "updated": 1789071763372, "link": null, "locked": false, "id": "el0109", "text": "Why no tensor scale: the latent is RMS-normalized, so |channel| <= sqrt(512) ~ 22.6 (observed ~10), while E4M3 x E2M1 already reaches 448 x 6 = 2688.", "originalText": "Why no tensor scale: the latent is RMS-normalized, so |channel| <= sqrt(512) ~ 22.6 (observed ~10), while E4M3 x E2M1 already reaches 448 x 6 = 2688.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "middle", "lineHeight": 1.25, "autoResize": false, "containerId": null}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#fdf8f6", "lockedMultiSelections": {}}, "files": {}}