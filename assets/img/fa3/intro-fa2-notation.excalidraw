  {
   "id": "el0130",
   "type": "text",
   "x": 436,
   "y": 100,
   "width": 314.6,
   "height": 123.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 652132316,
   "version": 1,
   "versionNonce": 80336782,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "m_i    scalar: max of x_1 .. x_i\nd_i'   scalar: sum of exp(x_j - m_i), j <= i\no_i'   row (1, d): weighted sum of V rows so far\n\nx_i = Q[k, :] K^T[:, i]\nm_i = max(m_(i-1), x_i)\nd_i' = d_(i-1)' exp(m_(i-1) - m_i) + exp(x_i - m_i)\no_i' = o_(i-1)' (d_(i-1)' / d_i') exp(m_(i-1) - m_i)\n       + (exp(x_i - m_i) / d_i') V[i, :]",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "m_i    scalar: max of x_1 .. x_i\nd_i'   scalar: sum of exp(x_j - m_i), j <= i\no_i'   row (1, d): weighted sum of V rows so far\n\nx_i = Q[k, :] K^T[:, i]\nm_i = max(m_(i-1), x_i)\nd_i' = d_(i-1)' exp(m_(i-1) - m_i) + exp(x_i - m_i)\no_i' = o_(i-1)' (d_(i-1)' / d_i') exp(m_(i-1) - m_i)\n       + (exp(x_i - m_i) / d_i') V[i, :]",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0131",
   "type": "text",
   "x": 420,
   "y": 258,
   "width": 653.4000000000001,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#495057",
