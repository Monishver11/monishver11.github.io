   "seed": 1890322093,
   "version": 1,
   "versionNonce": 786442398,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rows of O are independent, so a block of B_r query rows runs the same recurrence with\nm and d' as vectors of length B_r and o' as a (B_r, d) block; the key axis is walked B_c at a time.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Rows of O are independent, so a block of B_r query rows runs the same recurrence with\nm and d' as vectors of length B_r and o' as a (B_r, d) block; the key axis is walked B_c at a time.",
   "autoResize": true,
   "lineHeight": 1.25
  }
