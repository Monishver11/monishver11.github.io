  },
  {
   "id": "el0071",
   "type": "text",
   "x": 40,
   "y": 338,
   "width": 818.4000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1460519318,
   "version": 1,
   "versionNonce": 225810526,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CTA: 384 threads = 3 warpgroups, 2 Q tiles (128 rows), grid halved in M.   Registers: 128 x 24 + 256 x 240 = 64512 of 65536.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CTA: 384 threads = 3 warpgroups, 2 Q tiles (128 rows), grid halved in M.   Registers: 128 x 24 + 256 x 240 = 64512 of 65536.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0072",
   "type": "text",
   "x": 40,
   "y": 362,
   "width": 554.4000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 439717025,
   "version": 1,
   "versionNonce": 1001929,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMEM at d = 128: 2 Q stages (32 KB) + 5 KV stages (160 KB) = 192 KB, one CTA per SM.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMEM at d = 128: 2 Q stages (32 KB) + 5 KV stages (160 KB) = 192 KB, one CTA per SM.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0073",
   "type": "text",
   "x": 40,
   "y": 386,
   "width": 983.4000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 649677952,
   "version": 1,
   "versionNonce": 435786141,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Causal: the producer loads the KV range of the later tile; the earlier tile sees its one extra tile fully masked, so both consumers stay in lockstep.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Causal: the producer loads the KV range of the later tile; the earlier tile sees its one extra tile fully masked, so both consumers stay in lockstep.",
   "autoResize": true,
   "lineHeight": 1.25
  }
 ],
