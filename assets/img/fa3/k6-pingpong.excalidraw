  {
   "id": "el0069",
   "type": "text",
   "x": 150,
   "y": 280,
   "width": 901.45,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 896631051,
   "version": 1,
   "versionNonce": 1892478002,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the ordering barrier (PipelineOrder, 2 groups) makes the WGMMA issue alternate A, B, A, B. While one warpgroup's GEMMs run, the other is in\nits softmax on the FP32 and SFU units. Both pipelines are complete; they are offset in time. Idle gaps appear when a softmax outlasts the other GEMM.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the ordering barrier (PipelineOrder, 2 groups) makes the WGMMA issue alternate A, B, A, B. While one warpgroup's GEMMs run, the other is in\nits softmax on the FP32 and SFU units. Both pipelines are complete; they are offset in time. Idle gaps appear when a softmax outlasts the other GEMM.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0070",
