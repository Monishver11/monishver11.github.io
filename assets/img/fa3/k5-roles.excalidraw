   "updated": 1,
   "link": null,
   "locked": false,
   "text": "K5: setmaxnreg.dec to 24 in the producer, .inc to 240 in the consumer\n128 x 24 + 128 x 240 = 33792 per CTA; acc_pv (64 at d = 128), acc_qk (32), P (16) fit",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "K5: setmaxnreg.dec to 24 in the producer, .inc to 240 in the consumer\n128 x 24 + 128 x 240 = 33792 per CTA; acc_pv (64 at d = 128), acc_qk (32), P (16) fit",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0065",
   "type": "text",
   "x": 20,
   "y": 375,
   "width": 1128.6000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1713601029,
   "version": 1,
   "versionNonce": 1692732590,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What changed vs K4.2: the same consumer body, but the TMA issue loop moved to its own warpgroup, so loads are no longer interleaved with compute in one instruction stream.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What changed vs K4.2: the same consumer body, but the TMA issue loop moved to its own warpgroup, so loads are no longer interleaved with compute in one instruction stream.",
   "autoResize": true,
   "lineHeight": 1.25
  }
