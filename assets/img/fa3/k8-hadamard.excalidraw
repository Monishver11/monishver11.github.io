  {
   "id": "el0039",
   "type": "text",
   "x": 40,
   "y": 190,
   "width": 314.6,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1783314826,
   "version": 1,
   "versionNonce": 1352383822,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "max |x| = 14, step 14 / 448 = 1/32:\nthe small entries lose most of their 3 mantissa bits",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "max |x| = 14, step 14 / 448 = 1/32:\nthe small entries lose most of their 3 mantissa bits",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0040",
   "type": "text",
   "x": 460,
   "y": 190,
   "width": 302.5,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 86126515,
   "version": 1,
   "versionNonce": 1617126316,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "max |x| about 5, step about 1/90:\nthe same information, quantized about 3 bits finer",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "max |x| about 5, step about 1/90:\nthe same information, quantized about 3 bits finer",
   "autoResize": true,
   "lineHeight": 1.25
  },
