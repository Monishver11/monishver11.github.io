   "versionNonce": 2002530365,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "scores are unchanged: (Q S H)(K S H)^T = Q S H H^T S K^T = Q K^T,  since S = diag(+-1) and H H^T = I for H = Hadamard(d) / sqrt(d)",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "scores are unchanged: (Q S H)(K S H)^T = Q S H H^T S K^T = Q K^T,  since S = diag(+-1) and H H^T = I for H = Hadamard(d) / sqrt(d)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0043",
   "type": "text",
   "x": 15.574999999999989,
   "y": 258,
   "width": 828.85,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1515762054,
   "version": 1,
   "versionNonce": 1514306616,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FA3 folds this rotation into the rotary embedding before attention; here it is preprocessing, outside the timed region. V is not rotated.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FA3 folds this rotation into the rotary embedding before attention; here it is preprocessing, outside the timed region. V is not rotated.",
   "autoResize": true,
   "lineHeight": 1.25
  },
