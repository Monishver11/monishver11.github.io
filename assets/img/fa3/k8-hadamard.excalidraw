  {
   "id": "el0042",
   "type": "text",
   "x": 36.74999999999994,
   "y": 236,
   "width": 786.5000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
