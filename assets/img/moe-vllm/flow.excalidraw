   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GEMM 1 and GEMM 2 both use\nsorted_token_ids and expert_ids,\nso each block uses one expert's\nweights. GEMM 2 gets top_k = 1,\nso p // 1 = p.",
   "originalText": "GEMM 1 and GEMM 2 both use\nsorted_token_ids and expert_ids,\nso each block uses one expert's\nweights. GEMM 2 gets top_k = 1,\nso p // 1 = p.",
