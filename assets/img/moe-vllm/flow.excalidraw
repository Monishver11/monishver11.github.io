   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GEMM 1: token order -> pair order,\n  with p // top_k on the read side.\n\nmoe_sum: pair order -> token order,\n  with the sum over top_k rows.\n\nEverything between them stays\nin pair order.",
   "originalText": "GEMM 1: token order -> pair order,\n  with p // top_k on the read side.\n\nmoe_sum: pair order -> token order,\n  with the sum over top_k rows.\n\nEverything between them stays\nin pair order.",
   "fontSize": 14,
   "fontFamily": 1,
